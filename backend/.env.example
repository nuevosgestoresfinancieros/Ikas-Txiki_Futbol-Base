MONGO_URL=mongodb://localhost:27017
DB_NAME=ikas_txiki
CORS_ORIGINS=http://localhost:3000
# URL pública usada en enlaces de activación y recuperación. En producción:
# https://ikasfutbase.cibermedida.es
PUBLIC_APP_URL=http://localhost:3000
JWT_SECRET=sustituye-por-una-clave-aleatoria-de-32-caracteres-o-mas
# Cambiar JWT_SECRET invalida sesiones y también invitaciones/recuperaciones pendientes.
ADMIN_USER=admin_local
ADMIN_PASSWORD=sustituye-por-una-contrasena-segura

# Protección de acceso. Los límites del backend impiden valores inseguros.
LOGIN_WINDOW_SECONDS=600
LOGIN_MAX_ATTEMPTS=6
ACCOUNT_LOCK_MINUTES=15

# Borradores de preparación: caducidad automática entre 1 hora y 90 días.
IMPORT_STAGING_TTL_HOURS=168

# Correo opcional. Sin SMTP_HOST y SMTP_FROM los envíos quedan pendientes.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_USE_SSL=false

# Telegram opcional. No incluir valores reales en Git. El bot solo puede enviar
# a personas que hayan conectado previamente su chat y aceptado Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Proveedor futuro opcional; no activa envíos por sí solo.
SMS_PROVIDER_URL=
SMS_TOKEN=
# Asistente híbrido (sin proveedor externo por defecto)
ASSISTANT_PROPOSAL_TTL_SECONDS=600
ASSISTANT_PROVIDER_TIMEOUT_SECONDS=5
# El modo externo permanece desactivado hasta conectar un transporte revisado.
ASSISTANT_PROVIDER_MODE=disabled
ASSISTANT_PROVIDER_URL=
ASSISTANT_PROVIDER_MODEL=
ASSISTANT_PROVIDER_API_KEY=
