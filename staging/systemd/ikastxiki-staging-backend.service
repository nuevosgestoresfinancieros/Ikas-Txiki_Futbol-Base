[Unit]
Description=Ikas-Txiki staging API
After=network.target

[Service]
Type=exec
User=cibermedida
WorkingDirectory=/var/www/ikastxiki-staging/backend
EnvironmentFile=/etc/ikastxiki/staging.env
ExecStart=/var/www/ikastxiki-staging/backend/venv/bin/gunicorn server:app --worker-class uvicorn.workers.UvicornWorker --workers 2 --bind 127.0.0.1:18003 --timeout 30 --graceful-timeout 15 --keep-alive 5 --max-requests 2000 --max-requests-jitter 200
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
LimitNOFILE=8192
MemoryMax=1400M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/www/ikastxiki-staging/backend/uploads
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
